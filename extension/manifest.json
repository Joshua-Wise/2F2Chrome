{
  "manifest_version": 3,
  "name": "2F2Chrome",
  "version": "1.4",
  "description": "Automatically captures 2FA codes from Google Messages",
  "permissions": [
    "storage",
    "notifications",
    "clipboardWrite",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://messages.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://messages.google.com/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "patterns.json"
      ],
      "matches": [
        "https://messages.google.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
